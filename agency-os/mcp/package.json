{
  "name": "@agency-os/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Passerelle MCP d'Agency AI OS : permissions, portées, quotas, audit, connecteurs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "verify:firecrawl": "tsx scripts/verify-firecrawl.ts"
  },
  "dependencies": {
    "@agency-os/shared": "workspace:*",
    "@agency-os/database": "workspace:*",
    "@agency-os/tasks": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.13.0",
    "drizzle-orm": "^0.38.3",
    "firecrawl-mcp": "^1.12.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
