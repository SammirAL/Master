# ─────────────────────────────────────────────────────────────────────────────
# Agency AI OS — variables d'environnement (exemple)
# Copier en `.env` et renseigner. NE JAMAIS committer de secrets réels.
# ─────────────────────────────────────────────────────────────────────────────

# Environnement d'exécution
NODE_ENV=development

# ── PostgreSQL (source de vérité transactionnelle) ──────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agency
POSTGRES_PASSWORD=agency
POSTGRES_DB=agency_os
# URL complète dérivée des variables ci-dessus (utilisée par Drizzle)
DATABASE_URL=postgresql://agency:agency@localhost:5432/agency_os

# ── Redis (files BullMQ, verrous, cache) ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Qdrant (mémoire vectorielle) ────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── n8n (workflows externes, phases ultérieures) ────────────────────────────
N8N_URL=http://localhost:5678

# ── LLM (branché en phase 3) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Coffre à secrets (référence, phases ultérieures) ────────────────────────
# Les credentials par site/client ne transitent jamais en clair par les prompts.
VAULT_ADDR=
VAULT_TOKEN=
