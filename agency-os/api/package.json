{
  "name": "@agency-os/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API HTTP d'Agency AI OS (tâches + gouvernance)",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@agency-os/shared": "workspace:*",
    "@agency-os/tasks": "workspace:*",
    "@agency-os/backend": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
