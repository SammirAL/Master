{
  "name": "agency-os",
  "version": "0.0.0",
  "private": true,
  "description": "Agency AI OS — système d'exploitation d'entreprise IA multi-agents",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "ci:deps": "node infra/ci/check-circular-deps.mjs",
    "ci:yaml": "node infra/ci/validate-yaml.mjs",
    "db:generate": "pnpm --filter @agency-os/database generate",
    "db:migrate": "pnpm --filter @agency-os/database migrate",
    "db:seed": "pnpm --filter @agency-os/database seed",
    "demo:task": "pnpm --filter @agency-os/database demo:task"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
